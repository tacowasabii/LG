# 배포 빌드 설정
#
# VITE_API_URL은 여기 적지 않는다. 배포마다 백엔드 주소가 다르고, 파일에 박아 두면
# 남의 백엔드로 붙는 사고가 난다 (실제로 한 번 있었다).
# Vercel 프로젝트 Settings > Environment Variables 에 넣는다:
#
#   VITE_API_URL = https://<내-railway-앱>.up.railway.app/api
#
# Vite는 실제 환경변수를 .env 파일보다 우선한다. 값이 없으면 같은 도메인의 /api를
# 부르게 되고, Vercel에는 백엔드가 없으니 화면이 비어 보인다 — 그때는 이 변수를
# 설정하지 않은 것이다.

VITE_STATIC_MODE=false
