# Python
venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.env

# Node
frontend/node_modules/
frontend/dist/

# Data (keep structure, ignore generated/large files)
data/media/*
data/graph.json
# 채점 결과는 그래프 상태에 딸린 생성물이다 (scripts/run_trust_harness.py)
data/trust_report.json
# 미세 모션 클립의 자르기 전 생성 결과 (build_motion_covers.py --keep-source).
# 루프 길이를 다시 맞출 때만 필요한 중간물이다. 클립 자체는 커밋한다.
data/motion/*.source.mp4
# 루프 설정을 눈으로 비교할 때 쓰는 임시 자리 (build_motion_covers 로 만든다)
data/motion/compare/
# 런타임에 만든 클립의 목록과 지출 기록. 실행 중에 쌓이는 상태다
# (배포에서는 STATE_DIR 볼륨에 있고, 로컬에서는 data/ 가 STATE_DIR이다).
data/motion_manifest.json
data/motion_spend.json
data/motion_covers.json
data/motion_baseline.json
# 내보낸 아카이브와 가족 공간 설정 (실행 중 만들어진다)
data/exports/
# 구운 Memory Film. 사람이 스크립트로 만들고(scripts/render_film.py) 필요한 것만
# 골라 커밋한다 — 전부 담으면 사건마다 수 MB가 쌓인다.
data/films/*.mp4
data/family_space.json
data/profiles/*
!data/media/.gitkeep
!data/profiles/.gitkeep

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo
.vercel
.env*
