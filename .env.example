# LLM API Configuration
#
# 키를 비워두면 시뮬레이션 응답으로 동작합니다 (chat / interview / tv 모두).

# EXAONE (발표용) - Friendli.ai dedicated endpoint
EXAONE_API_URL=https://api.friendli.ai/dedicated/v1/chat/completions
EXAONE_API_KEY=your-friendli-token-here
EXAONE_MODEL=depe675tjc2rcpo

# 샘플링 파라미터 (EXAONE Deep 권장값)
# 추론 모드에서 temperature를 낮추면 오히려 품질이 떨어집니다.
EXAONE_TEMPERATURE=1.0
EXAONE_TOP_P=0.95
EXAONE_PRESENCE_PENALTY=0.0

# 추론(thinking) 모드
# true면 <thought> 블록을 받아 서버에서 걷어낸 뒤 본문만 내려보냅니다.
# 응답이 느려서 발표에 부담되면 false로 내리세요.
EXAONE_ENABLE_THINKING=true
# 추론이 토큰 예산을 다 먹어 본문이 잘리면 이 값을 올리세요.
EXAONE_THINKING_BUDGET=1536
EXAONE_TIMEOUT=120

# OpenAI 호환 엔드포인트로도 테스트 가능 (chat_template_kwargs는 무시됨)
# EXAONE_API_URL=https://api.openai.com/v1/chat/completions
# EXAONE_API_KEY=sk-xxx
# EXAONE_MODEL=gpt-4o-mini
# EXAONE_ENABLE_THINKING=false

# --- 저장소 (선택) ---
# 값이 있으면 그래프를 Postgres에 넣고, 없으면 data/graph.json 한 파일을 씁니다.
# 로컬 개발은 비워 두는 것이 편합니다.
# DATABASE_URL=postgresql://user:password@localhost:5432/homestory

# 상태(그래프·업로드·내보내기)를 쌓을 디렉터리. 배포에서는 여기에 볼륨을 붙입니다.
# 읽기 전용 자산(data/metadata, data/photos)과 나눠 두려는 것이라
# data/ 자체를 가리키면 안 됩니다.
# STATE_DIR=/app/var

# --- 앱 주소 (선택) ---
# 초대 링크에 쓰는 프론트 주소. 없으면 화면이 자기 origin으로 링크를 만듭니다.
# APP_BASE_URL=https://my-homestory.vercel.app

# --- Bedrock (선택) ---
# EXAONE은 한국어 서술·호칭·세대별 어투가 걸린 곳(채팅 답변·인터뷰 질문·내레이션)에
# 쓰고, JSON 조각만 뽑는 기계적인 호출은 여기로 보낼 수 있습니다.
# 키를 넣지 않으면 전부 EXAONE으로 돕니다 — 화면이 깨지지 않습니다.
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
# AWS_REGION=us-east-1
#
# 모델은 이 한 줄로 바꿉니다 (Claude·Nova·Llama 모두 같은 API입니다).
#   빠름   us.anthropic.claude-haiku-4-5-20251001-v1:0   (기본값)
#   최상   us.anthropic.claude-opus-5
# BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
#
# 어느 용도를 어디로 보낼지 (bedrock | exaone). 기본은 아래와 같습니다.
# LLM_PLAN_PROVIDER=bedrock      # 질문에서 검색 조건 뽑기 (채팅 응답 시간에 더해짐)
# LLM_EXTRACT_PROVIDER=bedrock   # 인터뷰 답변에서 인물·장소·날짜 뽑기
