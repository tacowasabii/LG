# LLM API Configuration
#
# 키를 비워두면 시뮬레이션 응답으로 동작합니다 (chat / interview / tv 모두).

# EXAONE (발표용) - Friendli.ai dedicated endpoint
EXAONE_API_URL=https://api.friendli.ai/dedicated/v1/chat/completions
EXAONE_API_KEY=your-friendli-token-here
EXAONE_MODEL=depe675tjc2rcpo

# 샘플링 파라미터 (EXAONE Deep 권장값)
# 추론 모드에서 temperature를 낮추면 오히려 품질이 떨어집니다.
EXAONE_TEMPERATURE=1.0
EXAONE_TOP_P=0.95
EXAONE_PRESENCE_PENALTY=0.0

# 추론(thinking) 모드
# true면 <thought> 블록을 받아 서버에서 걷어낸 뒤 본문만 내려보냅니다.
#
# 정답표 18문항으로 두 설정을 재봤습니다 (2026-08-20).
#   instant + thinking=false : 여섯 지표 전부 100 · 176초 · 채팅 평균 3.6초
#   thinking 모델 + true     : 여섯 지표 전부 100 · 256초 · 채팅 평균 7.4초
# 품질 차이는 없고 속도만 2배 차이가 나서, 기본값을 instant로 둡니다.
# 추론 모드는 본문이 비어 오는 실패 모드(토큰 예산 부족)도 함께 옵니다.
EXAONE_MODEL=chatexaone-code-cli-claude-compatible-instant
EXAONE_ENABLE_THINKING=false
# 추론이 토큰 예산을 다 먹어 본문이 잘리면 이 값을 올리세요.
EXAONE_THINKING_BUDGET=1536
EXAONE_TIMEOUT=120

# OpenAI 호환 엔드포인트로도 테스트 가능 (chat_template_kwargs는 무시됨)
# EXAONE_API_URL=https://api.openai.com/v1/chat/completions
# EXAONE_API_KEY=sk-xxx
# EXAONE_MODEL=gpt-4o-mini
# EXAONE_ENABLE_THINKING=false

# --- 저장소 (선택) ---
# 값이 있으면 그래프를 Postgres에 넣고, 없으면 data/graph.json 한 파일을 씁니다.
# 로컬 개발은 비워 두는 것이 편합니다.
# DATABASE_URL=postgresql://user:password@localhost:5432/homestory

# 상태(그래프·업로드·내보내기)를 쌓을 디렉터리. 배포에서는 여기에 볼륨을 붙입니다.
# 읽기 전용 자산(data/metadata, data/photos)과 나눠 두려는 것이라
# data/ 자체를 가리키면 안 됩니다.
# STATE_DIR=/app/var

# --- 앱 주소 (선택) ---
# 초대 링크에 쓰는 프론트 주소. 없으면 화면이 자기 origin으로 링크를 만듭니다.
# APP_BASE_URL=https://my-homestory.vercel.app

# --- Bedrock (선택) ---
# EXAONE은 한국어 서술·호칭·세대별 어투가 걸린 곳(채팅 답변·인터뷰 질문·내레이션)에
# 쓰고, JSON 조각만 뽑는 기계적인 호출은 여기로 보낼 수 있습니다.
# 키를 넣지 않으면 전부 EXAONE으로 돕니다 — 화면이 깨지지 않습니다.
#
# 예외 하나: **사진 장면 설명은 여기가 아니면 안 됩니다.** EXAONE 게이트웨이는
# 이미지를 받지 않으므로, 키가 없으면 사진 설명을 만들지 않고 비워 둡니다
# (사진을 보지 않고 쓴 문장을 "AI가 읽은 내용"으로 남기지 않습니다).
# 그러면 추억 초안이 사진 내용을 모른 채 날짜·좌표만으로 제목을 씁니다.
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
# AWS_REGION=us-east-1
#
# 모델은 이 한 줄로 바꿉니다 (Claude·Nova·Llama 모두 같은 API입니다).
#   빠름   us.anthropic.claude-haiku-4-5-20251001-v1:0   (기본값)
#   최상   us.anthropic.claude-opus-5
# BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
#
# 어느 용도를 어디로 보낼지 (bedrock | exaone). 기본은 아래와 같습니다.
# LLM_PLAN_PROVIDER=bedrock      # 질문에서 검색 조건 뽑기 (채팅 응답 시간에 더해짐)
# LLM_EXTRACT_PROVIDER=bedrock   # 인터뷰 답변에서 인물·장소·날짜 뽑기


# --- fal (선택) — 미세 모션 클립 ---
# 사진을 짧은 클립으로 만드는 scripts/build_motion_covers.py 에서만 씁니다.
# 로컬에서 손으로 돌리는 스크립트라 서버·배포에는 필요하지 않습니다.
# 생성 1회마다 과금되고 실패한 생성도 돈이 나갑니다 (480p 5초 약 $0.2).
# 키가 없으면 스크립트가 멈추고, 화면은 CSS 카메라 움직임으로 그대로 돕니다.
# FAL_KEY=

# 미세 모션 클립을 Film을 만들 때 그 자리에서 만들지 여부.
#
# 켜면 돈이 나갑니다 (480p 한 장 약 $0.2). 그리고 이 API에는 인증이 없어서
# 주소를 아는 누구나 생성을 일으킬 수 있으므로, 상한을 함께 둡니다. 상한을
# 넘으면 더 만들지 않고 클립이 없는 사진은 원래대로 CSS 카메라 움직임으로
# 돕니다. 센 횟수는 STATE_DIR에 남아 재시작에도 유지됩니다.
#
# FAL_KEY가 없거나 ffmpeg가 없으면 이 값과 무관하게 꺼진 것처럼 동작합니다.
# MOTION_AUTOGEN=true
# MOTION_AUTOGEN_MAX=50          # 누적 상한. 50건 = 약 $10
#
# 사건 하나에서 만들 사진 수의 상한. 사진이 이보다 적으면 전부 만듭니다 —
# 미세 모션은 정적으로 보이는 사진도 살립니다(머리카락·옷자락). 넘칠 때만
# 모델이 사진 설명을 읽고 대표를 고릅니다(cover_picker). 고른 결과는 STATE_DIR에
# 남아 방문마다 다시 묻지 않습니다.
# MOTION_COVERS_PER_EVENT=3
#
# 생성·후처리 기본값 (왜 이 값인지는 README "미세 모션 클립" 절)
# MOTION_RESOLUTION=480p         # 480p | 580p | 720p
# MOTION_SOURCE_SECONDS=5        # 모델에 요청하는 길이
# MOTION_USE_SECONDS=2.0         # 그중 앞 몇 초만 쓸지
# MOTION_LOOP_MODE=none          # none | crossfade | pingpong
# MOTION_CROSSFADE=0.5
